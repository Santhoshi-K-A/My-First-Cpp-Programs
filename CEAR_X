let vx;if(inG)vx=(t?-1:1)*(g%2?-1:1)*E+(Math.random()-.5)*turb;else vx=-Math.sign(x)*.35+(Math.random()-.5)*.3;
let nx=x+vx*dt;const ng=Math.floor((nx+1.75)/.5);if(inG&&ng!==g)nx=x-vx*dt*.3;
y+=fv*dt+(Math.random()-.5)*turb*dt*.8;z=cl(z+(Math.random()-.5)*turb*dt*1.2,-.85,.85);
if(y>.95){y=-.95;nx=-1.7+Math.random()*3.4}if(y<-.95)y=-.95;P[o]=cl(nx,-1.95,1.95);P[o+1]=y;P[o+2]=z}}
/* ---------- render ---------- */
let vs={vx:[.04,.03,.03],vh:.03,out:null},U={},aT=0;
for(const p of[PM,PP]){const n=gl.getProgramParameter(p,gl.ACTIVE_UNIFORMS);for(let i=0;i<n;i++){const nm=gl.getActiveUniform(p,i).name;U[p===PM?'m_'+nm:'p_'+nm]=gl.getUniformLocation(p,nm)}}
let VP,CAM;
function draw(g,M,c,a=1,met=0,em=0,mode=0,pp=0){gl.uniformMatrix4fv(U.m_uM,false,M);gl.uniform3fv(U.m_uC,c);gl.uniform1f(U.m_uA,a);gl.uniform1f(U.m_uMet,met);gl.uniform1f(U.m_uEm,em);gl.uniform1f(U.m_uMode,mode);gl.uniform1f(U.m_uP,pp);
gl.bindBuffer(gl.ARRAY_BUFFER,g.v);const aP=gl.getAttribLocation(PM,'aP'),aN=gl.getAttribLocation(PM,'aN');gl.enableVertexAttribArray(aP);gl.enableVertexAttribArray(aN);gl.vertexAttribPointer(aP,3,gl.FLOAT,false,24,0);gl.vertexAttribPointer(aN,3,gl.FLOAT,false,24,12);gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,g.x);gl.drawElements(gl.TRIANGLES,g.n,gl.UNSIGNED_SHORT,0)}
const SIL=[.72,.76,.8],GRA=[.2,.22,.27],CY=[.2,.85,1],EM=[.25,.95,.6],AM=[1,.7,.28];
const fl=k=>S.flash[k]||0,mix3=(a,b,t)=>a.map((q,i)=>mix(q,b[i],t));
function scene(){
const o=sim.out,v=vs;gl.useProgram(PM);gl.uniformMatrix4fv(U.m_uVP,false,VP);gl.uniform3fv(U.m_uCam,CAM);
gl.disable(gl.CULL_FACE);gl.enable(gl.DEPTH_TEST);gl.enable(gl.BLEND);gl.blendFunc(gl.SRC_ALPHA,gl.ONE_MINUS_SRC_ALPHA);gl.depthMask(true);
draw(G.cube,TM(0,-1.66,0,9,.01,6),[0,0,0],.6,0,0,1);
/* structure */
draw(G.cube,TM(0,-1.45,0,5,.26,2.9),GRA,1,.8);draw(G.cube,TM(0,-1.29,0,4.5,.06,2.4),SIL,1,.9);
if(SH.chamber)for(const sx of[-1,1])for(const sz of[-1,1]){draw(G.cube,TM(s
/* electrodes */
if(SH.electrodes){const sh=fl('shear'),pu=fl('pulse'),rv=fl('reversal');
for(let i=0;i<7;i++){const x=-1.5+i*.5,an=i%2==0,sw=rv>0?(an?mix(0,1,rv):mix(1,0,rv)):(an?0:1),col=[mix(SIL[0],GRA[0],sw),mix(SIL[1],GRA[1],sw),mix(SIL[2],GRA[2],sw)];
const jit=sh*Math.sin(aT*60+i)*.01;draw(G.cube,TM(x+jit,-.2,0,.05,1.5,1.5),col,1,.85,Math.max(pu*.5,sh*.25));
draw(G.cyl,TM(x,.98,an?-.45:.45,.07,.85,.07),SIL,1,.9)}
draw(G.cube,TM(0,1.42,-.45,3.3,.08,.12),SIL,1,.9);draw(G.cube,TM(0,1.42,.45,3.3,.08,.12),SIL,1,.9);
draw(G.cyl,TM(-1.8,1.42,-.45,.2,.2,.2,1.5708),SIL,1,.9,.0);draw(G.cyl,TM(1.8,1.42,.45,.2,.2,.2,1.5708),GRA,1,.8);
draw(G.cyl,TM(-1.8,1.42,-.45,.14,.5,.14,1.5708),CY,1,.4,.25);draw(G.cyl,TM(1.8,1.42,.45,.14,.5,.14,1.5708),EM,1,.4,.25)}
/* piping + actuators */
if(SH.piping){draw(G.cyl,TM(-2.75,-.8,0,.36,1.3,.36,1.5708),SIL,1,.9);draw(G.cyl,TM(-2.15,-.8,0,.5,.12,.5,1.5708),GRA,1,.8);
draw(G.cyl,TM(2.75,.75,0,.36,1.3,.36,1.5708),SIL,1,.9);draw(G.cyl,TM(2.15,.75,0,.5,.12,.5,1.5708),GRA,1,.8);
draw(G.cube,TM(-2.9,-.8,0,.5,.55,.55),GRA,1,.8,fl('flow_adjust')*.9+cl(v.vh/.35,0,1)*(.5+.4*Math.sin(aT*6)));draw(G.cyl,TM(-2.9,-.45,0,.14,.4,.14),SIL,1,.9,fl('flow_adjust')*.7);
draw(G.cyl,TM(-1.9,1.45,-.6,.2,.6,.2),GRA,1,.8);draw(G.sph,TM(-1.9,1.78,-.6,.2,.2,.2),mix3(EM,[.7,.3,.9],cl(v.vx[2]/.35,0,1)),1,.2,.4+fl('conductivity_comp')*1.5+cl(v.vx[2]/.35,0,1)*.6*(.5+.5*Math.sin(aT*6)))}
/* sensors (conceptual locations) */
if(SH.sensors){const pu=.5+.5*Math.sin(aT*3)+fl('meas')*.5;for(const p of[[.25,.05,0],[-3.3,-.8,0],[1.85,.2,.7]])draw(G.sph,TM(p[0],p[1],p[2],.13,.13,.13),CY,1,.2,pu*1.2);
draw(G.cyl,TM(1.85,.85,.7,.05,1.4,.05),SIL,1,.9);draw(G.cyl,TM(-3.3,-.55,0,.05,.5,.05),SIL,1,.9)}
/* ions */
if(SH.ions){gl.useProgram(PP);gl.uniformMatrix4fv(U.p_uVP,false,VP);gl.uniform1f(U.p_uS,cv.height*.02*(7/cam.d*.9+.3)*1.6);gl.uniform1f(U.p_uD,cl(1-cl(v.vx[2]/.35,0,1)*.85,.1,1));gl.uniform1f(U.p_uH,cl(v.vh/.35,0,1));gl.uniform1f(U.p_uC,cl(v.vx[2]/.35,0,1));
gl.blendFunc(gl.SRC_ALPHA,gl.ONE);gl.depthMask(false);gl.bindBuffer(gl.ARRAY_BUFFER,pbuf);gl.bufferData(gl.ARRAY_BUFFER,P,gl.DYNAMIC_DRAW);
const a=gl.getAttribLocation(PP,'aP'),b=gl.getAttribLocation(PP,'aI');gl.enableVertexAttribArray(a);gl.enableVertexAttribArray(b);gl.vertexAttribPointer(a,3,gl.FLOAT,false,20,0);gl.vertexAttribPointer(b,2,gl.FLOAT,false,20,12);gl.drawArrays(gl.POINTS,0,NP);
gl.disableVertexAttribArray(a);gl.disableVertexAttribArray(b);gl.blendFunc(gl.SRC_ALPHA,gl.ONE_MINUS_SRC_ALPHA)}
/* transparent pass */
gl.useProgram(PM);gl.depthMask(false);
if(SH.passivation)for(let i=0;i<7;i++)draw(G.cube,TM(-1.5+i*.5,-.2,0,.062,1.51,1.51),AM,1,0,.4+fl('shear')*.4,2,Math.min(1.05,v.vx[0]/.55)*.95);
if(SH.electrolyte){const hk=cl(v.vh/.35,0,1),ck=cl(v.vx[2]/.35,0,1),b=[.05,.4,.65],r=[.7,.22,.1],u=[.3,.12,.4];const col=[0,1,2].map(i=>mix(mix(b[i],r[i],hk*.8),u[i],ck*.85));draw(G.cube,TM(0,-.1,0,4.1,2.2,1.9),col,.16+.3*Math.max(hk,ck),0,.12)}
if(SH.chamber)draw(G.cube,TM(0,0,0,4.2,2.4,2),[.55,.8,.95],.07,.3,0)}
function resize(){const d=Math.min(2,devicePixelRatio||1),w=cv.clientWidth*d|0,h=cv.clientHeight*d|0;if(cv.width!=w||cv.height!=h){cv.width=w;cv.height=h}gl.viewport(0,0,w,h)}
let tl=performance.now(),acc=0;const STEP=380;
function frame(ts){const rd=Math.min(.25,(ts-tl)/1000),dt=Math.min(.05,rd);tl=ts;resize();
if(!S.pause){aT+=dt;acc+=rd*1e3;while(acc>=STEP){acc-=STEP;step()}for(const k in S.flash)S.flash[k]=Math.max(0,S.flash[k]-dt*1.6);
vs.out=sim.out;for(let i=0;i<3;i++)vs.vx[i]+=(sim.x[i]-vs.vx[i])*Math.min(1,dt*6);vs.vh=vs.vx[1];stepP(dt,vs)}
gl.clearColor(0,0,0,0);gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);
const a=cv.width/cv.height;CAM=[cam.d*Math.cos(cam.p)*Math.sin(cam.y),cam.d*Math.sin(cam.p),cam.d*Math.cos(cam.p)*Math.cos(cam.y)];
VP=mul(persp(.66,a,.1,60),look(CAM));scene();lpu();
if(SH.labels)LB.forEach((q,i)=>{const p=q[1],c=[0,1,2,3].map(r=>VP[r]*p[0]+VP[4+r]*p[1]+VP[8+r]*p[2]+VP[12+r]);const e=lbs[i];if(c[3]<=0){e.style.opacity=0;return}e.style.opacity=.9;e.style.transform=`translate(${(c[0]/c[3]*.5+.5)*cv.clientWidth}px,${(1-(c[1]/c[3]*.5+.5))*cv.clientHeight}px)`});
requestAnimationFrame(frame)}
reset();vs.out=sim.out;ui();requestAnimationFrame(frame);
}catch(e){console.error(e);document.getElementById('fb').style.display='flex'}})();
